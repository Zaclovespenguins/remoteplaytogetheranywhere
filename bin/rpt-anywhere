#!/usr/bin/env bash
# rpt-anywhere: launched in place of a "donor" Steam game (via that game's
# Steam Launch Options, set to "/path/to/rpt-anywhere %command%"). Steam
# still believes the donor's AppID is running -- and therefore still offers
# Remote Play Together for it -- while this script actually execs whichever
# real game is currently selected via `rpt-select`. The donor's own %command%
# (passed to us as argv) is intentionally ignored.
#
# Because this process is a direct child of the process Steam itself spawned
# for the donor's launch, it inherits Steam's overlay-injection environment
# (LD_PRELOAD, VK_LAYER_PATH / ENABLE_VK_LAYER_VALVE_steam_overlay_*, etc.).
# Those env vars pass down unmodified through exec/Proton/Wine, so the Steam
# overlay (and therefore Remote Play Together, which streams the
# overlay-captured frame) attaches to the real game's window instead.
#
# Proton games are launched directly through Steam's own already-installed
# Proton build and Steam Linux Runtime container (the same "<runtime>/
# _v2-entry-point --verb=waitforexitandrun -- <proton>/proton
# waitforexitandrun <exe>" invocation Steam itself uses) -- no third-party
# launcher or extra dependency required.

set -uo pipefail

SHARE_DIR="$HOME/.local/share/rpt-anywhere"
REGISTRY="$SHARE_DIR/games.json"
RESOLVER="$SHARE_DIR/resolve.py"
STATE_DIR="$HOME/.local/state/rpt-anywhere"
ACTIVE_FILE="$STATE_DIR/active"
LOG="$STATE_DIR/rpt-anywhere.log"
LOCK_FILE="$STATE_DIR/rpt-anywhere.lock"
COMPATDATA_ROOT="$HOME/.local/share/Steam/steamapps/compatdata"
COMPAT_CLIENT_INSTALL="$HOME/.local/share/Steam"
MAX_LOG_BYTES=$((2 * 1024 * 1024))

mkdir -p "$STATE_DIR"

# Keep at most one previous session's log instead of growing forever.
if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt "$MAX_LOG_BYTES" ]; then
	mv -f "$LOG" "$LOG.previous"
fi

exec >>"$LOG" 2>&1
echo "===== $(date -Is) rpt-anywhere starting (donor argv ignored: $* ) ====="

# Refuse to stack two launches on top of each other (e.g. double-clicking Play).
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
	echo "FATAL: another rpt-anywhere is already running (lock held on $LOCK_FILE)"
	exit 1
fi

if [ ! -f "$ACTIVE_FILE" ]; then
	echo "FATAL: no active game selected. Run: rpt-select <name>"
	exit 1
fi
ACTIVE_NAME=$(<"$ACTIVE_FILE")

if [ ! -f "$REGISTRY" ]; then
	echo "FATAL: no registry at $REGISTRY"
	exit 1
fi

if ! command -v python3 >/dev/null; then
	echo "FATAL: python3 not found on PATH"
	exit 1
fi

RESOLVED=$(python3 "$RESOLVER" "$REGISTRY" "$ACTIVE_NAME") || {
	echo "FATAL: resolve.py itself failed unexpectedly"
	exit 1
}
eval "$RESOLVED"

if [ ! -f "$RPT_EXE" ]; then
	echo "FATAL: executable not found: $RPT_EXE"
	exit 1
fi

if [ ! -x "$RPT_PROTON_BIN" ]; then
	echo "FATAL: Proton binary not found or not executable: $RPT_PROTON_BIN"
	exit 1
fi

echo "Launching: $RPT_NAME (appid=$RPT_APPID) -> $RPT_EXE via $RPT_PROTON"

GAME_DIR=$(dirname -- "$RPT_EXE")

cd -- "$GAME_DIR" || { echo "FATAL: could not cd into $GAME_DIR"; exit 1; }

export STEAM_COMPAT_CLIENT_INSTALL_PATH="$COMPAT_CLIENT_INSTALL"
export STEAM_COMPAT_DATA_PATH="$COMPATDATA_ROOT/$RPT_APPID"

echo "env: STEAM_COMPAT_DATA_PATH=$STEAM_COMPAT_DATA_PATH PROTON_BIN=$RPT_PROTON_BIN RUNTIME_ENTRY=${RPT_RUNTIME_ENTRY:-<none>}"
echo "LD_PRELOAD passthrough: ${LD_PRELOAD:-<unset>}"

# shellcheck disable=SC2086
# (Word-split intentional: RPT_ARGS is a space-separated launch-args string.)
if [ -n "$RPT_RUNTIME_ENTRY" ]; then
	if [ ! -x "$RPT_RUNTIME_ENTRY" ]; then
		echo "FATAL: required Steam Linux Runtime entry point not found or not executable: $RPT_RUNTIME_ENTRY"
		exit 1
	fi
	exec "$RPT_RUNTIME_ENTRY" --verb=run -- "$RPT_PROTON_BIN" run "$RPT_EXE" $RPT_ARGS
else
	exec "$RPT_PROTON_BIN" run "$RPT_EXE" $RPT_ARGS
fi
